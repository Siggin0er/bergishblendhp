# Bergish Blend – Einstellungen für klassischen Apache-Webspace (statische Fassung)

DirectoryIndex index.html
Options -Indexes

# Immer https: erst aktivieren (die drei Zeilen ohne # davor), wenn das SSL-Zertifikat
# für bergishblend.de aktiv ist – sonst ist die Seite nicht erreichbar.
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Komprimierung für schnellere Ladezeiten
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Zwischenspeichern im Browser: Dateien in /assets haben eindeutige Namen und dürfen lange gecacht werden,
# HTML immer frisch laden, damit Änderungen sofort sichtbar sind.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
